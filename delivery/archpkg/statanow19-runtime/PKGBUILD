pkgname=statanow19-runtime
pkgver=19.5.0
pkgrel=2
pkgdesc='Packaged StataNow 19 runtime with bundled license builder and self-managed per-user workspace'
arch=('x86_64')
url='https://public.econ.duke.edu/stata/installers/19/StataNow19Linux64.tar.gz'
license=('custom')
depends=('ncurses')
makedepends=('libarchive')
source=(
  'statanow19-mp.sh'
  'xstatanow19-mp.sh'
  'statanow19-license-builder.sh'
  'statanow19-config.env.sample'
  'statanow19-mp.desktop'
  'mojave.gtkrc'
  'README.package.txt'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

_challenge_root=${CHALLENGE_ROOT:-$(cd "$startdir/../../.." && pwd)}
_gtk2_lib_root=${GTK2_LIB_ROOT:-$_challenge_root/runtime/localdeps/gtk2/usr/lib}
if [[ ! -d "$_gtk2_lib_root" ]]; then
  _gtk2_lib_root=${STATA18_GTK2_LIB_ROOT:-$(cd "$_challenge_root/../stata18-toolkit" && pwd)/runtime/localdeps/gtk2/usr/lib}
fi

prepare() {
  rm -rf "$srcdir/media" "$srcdir/runtime"
  mkdir -p "$srcdir/media" "$srcdir/runtime"
  bsdtar -xf "$_challenge_root/artifacts/original/StataNow19Linux64.tar.gz" -C "$srcdir/media"
  bsdtar -xf "$srcdir/media/unix/linux64/ado.taz" -C "$srcdir/runtime"
  bsdtar -xf "$srcdir/media/unix/linux64/base.taz" -C "$srcdir/runtime"
  bsdtar -xf "$srcdir/media/unix/linux64/bins.taz" -C "$srcdir/runtime"
}

package() {
  [[ -d "$_gtk2_lib_root" ]] || { echo "missing gtk2 libs: $_gtk2_lib_root" >&2; return 1; }

  install -d "$pkgdir/opt/statanow19-runtime/runtime.template"
  cp -a --no-preserve=ownership "$srcdir/runtime/." "$pkgdir/opt/statanow19-runtime/runtime.template/"

  install -d "$pkgdir/opt/statanow19-runtime/lib/gtk2" "$pkgdir/opt/statanow19-runtime/lib/ncurses6"
  cp -a --no-preserve=ownership "$_gtk2_lib_root/." "$pkgdir/opt/statanow19-runtime/lib/gtk2/"
  ln -s /usr/lib/libncursesw.so.6 "$pkgdir/opt/statanow19-runtime/lib/ncurses6/libncurses.so.6"
  ln -s /usr/lib/libtinfo.so.6 "$pkgdir/opt/statanow19-runtime/lib/ncurses6/libtinfo.so.6"

  install -d "$pkgdir/opt/statanow19-runtime/tools" "$pkgdir/opt/statanow19-runtime/share/themes" "$pkgdir/opt/statanow19-runtime/share/icons"
  install -m755 "$srcdir/statanow19-license-builder.sh" "$pkgdir/opt/statanow19-runtime/tools/statanow19-license-builder.sh"
  install -m644 "$srcdir/statanow19-config.env.sample" "$pkgdir/opt/statanow19-runtime/share/config.env.sample"
  install -m644 "$srcdir/mojave.gtkrc" "$pkgdir/opt/statanow19-runtime/share/themes/mojave.gtkrc"
  install -m644 "$srcdir/README.package.txt" "$pkgdir/opt/statanow19-runtime/README.txt"
  install -m644 "$srcdir/runtime/stata19.png" "$pkgdir/opt/statanow19-runtime/share/icons/stata19.png"

  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" "$pkgdir/usr/share/doc/$pkgname"
  install -m755 "$srcdir/statanow19-mp.sh" "$pkgdir/usr/bin/statanow19-mp"
  install -m755 "$srcdir/xstatanow19-mp.sh" "$pkgdir/usr/bin/xstatanow19-mp"
  install -m755 "$srcdir/statanow19-license-builder.sh" "$pkgdir/usr/bin/statanow19-license-builder"
  install -m644 "$srcdir/statanow19-mp.desktop" "$pkgdir/usr/share/applications/statanow19-mp.desktop"
  install -m644 "$srcdir/media/license.pdf" "$pkgdir/usr/share/doc/$pkgname/license.pdf"
}
